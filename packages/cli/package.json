{
  "name": "reeldiff",
  "version": "0.0.0",
  "private": true,
  "description": "Every PR gets a demo of what changed",
  "license": "MIT",
  "type": "module",
  "bin": {
    "reeldiff": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown && node scripts/copy-viewer.ts",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@reeldiff/adapters": "workspace:*",
    "@reeldiff/core": "workspace:*",
    "commander": "15.1.0"
  },
  "devDependencies": {
    "@reeldiff/typescript-config": "workspace:*",
    "@reeldiff/viewer": "workspace:*",
    "@types/node": "26.6.6",
    "tsdown": "0.23.7",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=22.20.0"
  },
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  }
}
