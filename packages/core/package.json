{
  "name": "@reeldiff/core",
  "version": "0.0.0",
  "private": true,
  "description": "Flow schema, runner, recorder and change detection for Reeldiff",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "schema"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "typecheck": "tsc",
    "schema": "node scripts/write-schema.ts"
  },
  "devDependencies": {
    "@reeldiff/typescript-config": "workspace:*",
    "@types/node": "26.6.6",
    "tsdown": "0.23.7",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "playwright": "1.65.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  }
}
