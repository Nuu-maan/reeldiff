{
  "name": "@reeldiff/core",
  "version": "0.0.0",
  "private": true,
  "description": "Flow schema, runner, recorder and change detection for Reeldiff",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "schema"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "typecheck": "tsc",
    "schema": "node scripts/write-schema.ts"
  },
  "devDependencies": {
    "@reeldiff/typescript-config": "workspace:*",
    "@types/node": "26.6.6",
    "@types/pngjs": "6.0.5",
    "tsdown": "0.23.7",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=22.20.0"
  },
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.102",
    "@ai-sdk/google": "4.0.118",
    "@ai-sdk/openai": "4.0.115",
    "@ai-sdk/openai-compatible": "3.0.90",
    "@browserbasehq/stagehand": "4.4.0",
    "@openrouter/ai-sdk-provider": "3.1.0",
    "ai": "7.0.170",
    "pixelmatch": "8.0.0",
    "playwright": "1.65.0",
    "pngjs": "7.0.0",
    "rrweb-snapshot": "2.2.2",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  }
}
